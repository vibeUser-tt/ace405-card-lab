  "fsm_states": [
    {
      "state": "SECURE",
      "when": "本回合对手自身已有或可建出达标方案",
      "action": "优先完成可达标建造；若已达标，优先用F08保护最容易被压制的卡，或用F05提高关键指标。仍可合法攻击。",
      "next": "下回合重新评估"
    },
    {
      "state": "PRESSURE",
      "when": "学生当前已通过至少3个硬门槛，或按公开权重领先10分以上；且对手手中有合法攻击",
      "action": "选择能让学生本轮失去达标资格的攻击；若都不能，选择使学生竞标分下降最多的攻击。优先同名反制，不能偷看学生手牌。",
      "next": "下回合重新评估"
    },
    {
      "state": "BUILD",
      "when": "对手手中存在预算内、体力内的可建措施，且能够改善目标缺口",
      "action": "在同一合法手牌中按公开的缺口效用选一张；有剩余体力时再考虑一张功能牌。",
      "next": "下回合重新评估"
    },
    {
      "state": "REFILL",
      "when": "没有能改善目标缺口的合法措施，或本回合体力不足",
      "action": "优先用F01/F02找牌或F03恢复体力；不能使用时保留手牌并结束回合。",
      "next": "下回合重新评估"
    }
  ],
  "rules": {
    "mode": "one human player versus one deterministic finite-state NPC; no student-to-student match",
    "rounds_max": 8,
    "starting_hand": 5,
    "draw_each_round_after_first": 5,
    "hand_limit": 8,
    "discard_unretained_hand_at_end_of_round": true,
    "base_stamina_per_round": 3,
    "stamina_turn_cap": 5,
    "extra_stamina_per_round_cap": 2,
    "stamina_does_not_carry": true,
    "extra_draw_per_round_cap": 4,
    "design_builds_per_round": 1,
    "attacks_per_round": 1,
    "function_cards_per_round": 2,
    "budget_cap": 100,
    "one_design_per_slot": true,
    "old_global_AP_replaced_by_per_round_stamina": true,
    "measure_cards_unique_per_deck": true,
    "start_deck": "two measures per unlocked slot, with a verified feasible route included, plus eight unlocked function cards; from W4 guarantee one F06, from W5 guarantee one F08; at most 20 cards",
    "identical_initial_deck_order_for_player_and_NPC": false,
    "same_name_attack": {
      "cost_stamina": 1,
      "requires_exact_opponent_installed_card_id": true,
      "suppresses_beneficial_marginal_fraction": 0.5,
      "duration": "current review only",
      "card_exiled_for_run": true
    },
    "generic_attack": {
      "card_id": "F06",
      "cost_stamina": 1,
      "suppresses_beneficial_marginal_fraction": 0.25,
      "duration": "current review only"
    },
    "amplifier": {
      "card_id": "F07",
      "extra_suppression_fraction": 0.25,
      "suppression_cap": 0.75
    },
    "buff": {
      "card_id": "F05",
      "beneficial_marginal_fraction_bonus": 0.25,
      "buff_cap": 0.25
    },
    "shield": {
      "card_id": "F08",
      "blocks_first_attack_on_selected_installed_card_this_review": true
    },
    "marginal_formula": "m(card,metric)=F(current_design,metric)-F(current_design_without_card,metric), including interactions and clamps",
    "review_formula": "effective_metric = physical_proxy_metric + boost_fraction*m - suppression_fraction*m; only for a beneficial m; show both values; this is a game scoring layer, not a physical prediction",
    "score_formula": "S_E=clip(100*(120-E)/70); S_D=clip(100*(D-30)/50); S_H=clip(100*(200-H)/150); S_C=clip(100*(400-C)/200); score=sum_k(level_weight_k*S_k). Hard limits still apply before tie-break.",
    "qualification": "after simultaneous round resolution, all client hard limits and budget cap must be met; first side to qualify wins",
    "both_qualify_same_round": "higher disclosed weighted score wins; then lower budget; exact tie is a draw",
    "neither_qualifies_by_round_cap": "run ends without a winning bid at the level-specific cap of 5, 6, or 8 rounds; player may retry",
    "NPC_information": "public board and its own private hand only; no access to player hand or future draws",
    "NPC_intent": "before player acts, show state and intended target metric or action category; the NPC may react with a telegraphed shield and may build a newly drawn card after REFILL",
    "NPC_priority": [
      "SECURE",
      "PRESSURE",
      "BUILD",
      "REFILL"
    ],
    "NPC_build_utility": "prefer a build that qualifies now; otherwise prefer measures in a shortest remaining feasible route, then use weighted gap reduction, newly met gates, budget and stamina as tie-breaks",
    "level_generation": "select two measures per unlocked slot, insert a verified build-only winning route, then independently shuffle equal-composition player and NPC decks",
    "deck_recycle": "when draw pile is empty, shuffle the discard pile; installed design cards and exiled counter cards never re-enter the draw pile during the run",
    "progression": "all six course-week levels are selectable in this prototype; browser remembers best round for a qualifying student design, including a draw. No win-only power or student leaderboard. Optional sidegrades remain a future design proposal."
  }
}
